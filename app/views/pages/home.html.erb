<section class="custom-hero">
  <div class="custom-hero-container">
    <div class="custom-hero-content">
      <h1 class="custom-hero-title">Software Engineer</h1>
      <p class="custom-hero-subtitle">Building robust Ruby on Rails applications with modern frontend technologies. 3.6+ years of experience crafting scalable, user-focused solutions.</p>
      <div class="custom-hero-stack">
        <span class="custom-hero-pill">Ruby on Rails</span>
        <span class="custom-hero-pill">JavaScript</span>
        <span class="custom-hero-pill">HTML/CSS/Bootstrap</span>
        <span class="custom-hero-pill">Python</span>
        <span class="custom-hero-pill">PostgreSQL/MySQL/MongoDB</span>
      </div>
      <div class="custom-hero-actions">
        <%= link_to "View Projects", root_path(anchor: "projects"), class: "custom-hero-btn custom-hero-btn-primary" %>
        <%= link_to "Contact", contact_path, class: "custom-hero-btn custom-hero-btn-ghost" %>
      </div>
    </div>
  </div>
</section>

<section id="about" class="section about">
  <div class="container">
    <h2 class="section-heading">About</h2>
    <p>Software Engineer specializing in Ruby on Rails with strong frontend experience. I craft performant, maintainable, and user-focused features, collaborating closely with teams to deliver business value.</p>
    <p class="muted">Comfortable across the stack: APIs, background jobs, integrations, and responsive UI.</p>
  </div>
</section>

<section id="skills" class="skills-section">
  <div class="container">
    <h2 class="section-heading">Skills</h2>
    <div class="skills-grid">
      <div class="skill-card">
        <h3>Backend</h3>
        <div class="badges">
          <span class="badge">Ruby</span>
          <span class="badge">Ruby on Rails</span>
          <span class="badge">Python</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>Frontend</h3>
        <div class="badges">
          <span class="badge">HTML</span>
          <span class="badge">CSS</span>
          <span class="badge">Bootstrap</span>
          <span class="badge">JavaScript</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>Databases</h3>
        <div class="badges">
          <span class="badge">PostgreSQL</span>
          <span class="badge">MySQL</span>
          <span class="badge">MongoDB</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>Ops & Tools</h3>
        <div class="badges">
          <span class="badge">Git</span>
          <span class="badge">Redis</span>
          <span class="badge">Sidekiq</span>
          <span class="badge">Nginx</span>
          <span class="badge">Heroku</span>
          <span class="badge">AWS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="experience" class="experience-section">
  <div class="experience-container">
    <h2 class="section-heading">Experience</h2>
    <div class="experience-grid">
      <div class="experience-row">
        <div class="experience-item">
          <h3>Software Engineer — Bluebash Consulting Private Limited</h3>
          <div class="experience-meta">Jan 2023 — Present</div>
          <ul>
            <li>Built and maintained Rails features, integrations, and UI improvements.</li>
            <li>Collaborated with cross-functional teams to deliver secure, scalable systems.</li>
            <li>Worked with Redis, Sidekiq, and third-party integrations (payments, PubNub, etc.).</li>
          </ul>
        </div>
        <div class="experience-item">
          <h3>Full-Stack Developer Intern — Bluebash Consulting</h3>
          <div class="experience-meta">Jun 2022 — Dec 2022</div>
          <ul>
            <li>Built a gallery app with Rails (CRUD, Devise, Mailtrap), responsive UI with Bootstrap.</li>
            <li>Developed a dynamic bike purchasing web app with HTML/CSS/Bootstrap/JS.</li>
            <li>Learned best practices for authentication, authorization, and secure web apps.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="projects" class="projects-section">
  <div class="projects-container">
    <h2 class="section-heading">Projects</h2>
    <div class="projects-grid">
      <div class="projects-row">
        <% @projects.each do |p| %>
          <div class="project">
            <h3><%= link_to p.title, project_path(p), class: "project-title" %></h3>
            <p><%= p.description %></p>
            <div class="tech">
              <% p.tech_list.each do |t| %>
                <span class="badge"><%= t %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

